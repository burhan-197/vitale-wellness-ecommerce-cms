<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · Vitale Lite</title><link rel="stylesheet" href="/css/admin.css"></head><body class="auth-body"><form class="auth-card" method="post" action="/admin/setup"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><a class="admin-brand dark" href="/">VITALE <span>Lite</span></a><h1>Create the first admin</h1><p>This setup page is disabled automatically after the first admin is created.</p><% if (error) { %><div class="alert"><%= error %></div><% } %><label>Display name<input name="displayName" maxlength="100"></label><label>Username<input name="username" minlength="3" required maxlength="80"></label><label>Password<input type="password" name="password" minlength="8" required></label><% if (process.env.ADMIN_SETUP_TOKEN) { %><label>Setup token<input type="password" name="setupToken" required></label><% } %><button class="admin-button" type="submit">Create admin</button></form></body></html>
